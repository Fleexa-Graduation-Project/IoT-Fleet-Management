# ---------------------------------------------------------
# fleexa iot fleet management - root environment
# ---------------------------------------------------------
# orchestrator.py is a root-level script, so when running it directly
# (outside the devices/ docker-compose setup) it reads its environment
# from the repo root. This mirrors devices/.env.example — the variable
# set is identical, since both drive the same orchestrator.py /
# devices/simulators code.
#
# Copy this file to .env and populate with your credentials.
# Do NOT commit your .env file to version control!

# AWS Credentials (Required for dynamic DynamoDB user fetching)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional overrides
# MQTT_BROKER=your-iot-core-endpoint.iot.us-east-1.amazonaws.com
# USER_IDS=uuid-1,uuid-2
