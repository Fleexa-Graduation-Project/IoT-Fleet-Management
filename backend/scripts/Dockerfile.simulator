# backend/scripts/Dockerfile.simulator
# Lightweight image that runs simulate_devices.py automatically.
# Needs AWS credentials via env vars (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
# or an IAM role mounted through the host (e.g. ~/.aws bind-mount).

FROM python:3.11-slim

WORKDIR /app

# Only runtime deps needed: boto3
COPY backend/scripts/requirements.simulator.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the simulator script
COPY backend/scripts/simulate_devices.py ./simulate_devices.py

# Runs indefinitely (publishes every INTERVAL_SECONDS)
CMD ["python", "-u", "simulate_devices.py"]
