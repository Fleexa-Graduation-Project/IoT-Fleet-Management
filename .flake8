[flake8]
# Match black's default formatting so flake8 and black never disagree.
max-line-length = 88
extend-ignore =
    # E203: whitespace before ':' — black formats slices this way.
    E203,
    # W503: line break before binary operator — black's preferred style.
    W503

exclude =
    .git,
    .venv,
    venv,
    __pycache__,
    *.egg-info,
    build,
    dist,
    devices/certs,
    graphify-out,
    mobile,
    infra-iot-fleet/terraform,
    backend
